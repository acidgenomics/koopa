#!/bin/sh
set -eu

__koopa_realpath() {
    _rp_out="$(readlink -f "$1" 2>/dev/null || true)"
    if [ -z "$_rp_out" ]; then
        _rp_out="$( \
            perl -MCwd -le \
                'print Cwd::abs_path shift' \
                "$1" \
            2>/dev/null \
            || true \
        )"
    fi
    if [ -z "$_rp_out" ]; then
        _rp_out="$( \
            python3 -c \
                "import os, sys; print(os.path.realpath(sys.argv[1]))" \
                "$1" \
            2>/dev/null \
            || true \
        )"
    fi
    [ -n "$_rp_out" ] || return 1
    printf '%s\n' "$_rp_out"
}

__koopa_check_python() {
    [ -x "$1" ] && "$1" -c "import _bz2, _hashlib, _lzma, _ssl, zlib" \
        2>/dev/null
}

# Also duplicated in koopa.system.find_system_python() (Python side, used by
# _update_venv() in koopa.install) -- keep the exact major.minor match in
# sync between the two if either changes.
__koopa_python_version_matches() {
    [ -x "$1" ] && "$1" -c \
        "import sys; sys.exit(0 if sys.argv[1] == '{}.{}'.format(*sys.version_info[:2]) else 1)" \
        "$2" \
        2>/dev/null
}

_koopa_bin="$0"
if [ -L "$_koopa_bin" ]; then
    _koopa_bin="$(__koopa_realpath "$_koopa_bin")"
fi
[ -x "$_koopa_bin" ] || exit 1
_koopa_prefix="$(__koopa_realpath "$(dirname "$_koopa_bin")/..")"
[ -d "$_koopa_prefix" ] || exit 1

_venv_python="${_koopa_prefix}/.venv/bin/python3"
if [ -n "${KOOPA_BOOTSTRAP_PREFIX:-}" ]; then
    _bootstrap_python="${KOOPA_BOOTSTRAP_PREFIX}/bin/python3"
else
    _bootstrap_python="${_koopa_prefix}-bootstrap/bin/python3"
fi
_required_ver="$(cat "${_koopa_prefix}/.python-version" 2>/dev/null)"

_python=""
# Prefer whichever of venv/bootstrap actually matches .python-version. A
# stale interpreter left over from a prior pin still passes the module
# probe below and would otherwise win outright, so a host can silently run
# the wrong Python indefinitely instead of self-healing.
if [ -n "$_required_ver" ]; then
    if __koopa_python_version_matches "$_venv_python" "$_required_ver" && \
        __koopa_check_python "$_venv_python"
    then
        _python="$_venv_python"
    elif __koopa_python_version_matches "$_bootstrap_python" "$_required_ver" && \
        __koopa_check_python "$_bootstrap_python"
    then
        _python="$_bootstrap_python"
    fi
fi
if [ -z "$_python" ] && __koopa_check_python "$_venv_python"; then
    _python="$_venv_python"
fi
if [ -z "$_python" ]; then
    if __koopa_check_python "$_bootstrap_python"; then
        _python="$_bootstrap_python"
    elif [ -x "$_bootstrap_python" ]; then
        if [ "${1:-}" = "uninstall" ]; then
            exec sh "${_koopa_prefix}/uninstall.sh"
        fi
        if [ -z "$_python" ]; then
            printf '%s\n' \
                'Error: koopa bootstrap Python is invalid.' \
                '' \
                'Run the following to rebuild:' \
                "  sh '${_koopa_prefix}/bootstrap.sh'" \
                '' \
                'To uninstall koopa without Python:' \
                "  sh '${_koopa_prefix}/uninstall.sh'" \
                >&2
            exit 1
        fi
    fi
fi
if [ -z "$_python" ]; then
    if [ -n "$_required_ver" ]; then
        # /usr/bin/python3 first (matches historical behavior), then whatever
        # the .python-version-derived name (e.g. python3.12) or bare python3
        # resolve to on PATH -- an already-installed matching interpreter
        # there avoids running bootstrap.sh at all.
        for _sys_python in \
            /usr/bin/python3 \
            "$(command -v "python${_required_ver}" 2>/dev/null || true)" \
            "$(command -v python3 2>/dev/null || true)"
        do
            [ -n "$_sys_python" ] || continue
            if __koopa_python_version_matches "$_sys_python" "$_required_ver" && \
                __koopa_check_python "$_sys_python"
            then
                _python="$_sys_python"
                break
            fi
        done
    fi
fi
if [ -z "$_python" ]; then
    printf '%s\n' \
        'Error: koopa bootstrap Python not found.' \
        '' \
        'Run the following to bootstrap koopa:' \
        "  sh '${_koopa_prefix}/bootstrap.sh'" \
        '' \
        'To uninstall koopa without Python:' \
        "  sh '${_koopa_prefix}/uninstall.sh'" \
        >&2
    exit 1
fi

export KOOPA_PREFIX="$_koopa_prefix"
PYTHONPATH="${_koopa_prefix}/lang/python/src${PYTHONPATH:+:${PYTHONPATH}}" \
    exec "$_python" -m koopa.cli_main "$@"
