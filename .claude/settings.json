{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(**)",
      "Edit(//**/*lessons.md)",
      "Grep",
      "ListMcpResourcesTool",
      "Python(*)",
      "Read(**)",
      "ReadMcpResourceTool",
      "mcp__ide__*",
      "mcp__mcp-atlassian__*",
      "mcp__read-website-fast__*",
      "mcp__tooluniverse__*"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Edit(**/.env*)",
      "Edit(.env*)",
      "Read(**/.env*)",
      "Read(.env*)"
    ]
  }
}
