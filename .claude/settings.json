{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Edit(.claude/rules/lessons.md)",
      "Write(**/*.md)",
      "Grep",
      "Python(*)",
      "Read",
      "WebFetch"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)"
    ]
  }
}
