{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/block_tmux_kill_server.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/block_destructive_git.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/audit_secrets_before_push.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/push_gate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_installs.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/block_uv.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_broad_scan.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_rm.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env AGENT_HOOK_HARNESS=copilot python3 \"${PLUGIN_ROOT}/hooks/guard_hook_writes.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env AGENT_HOOK_HARNESS=copilot python3 \"${PLUGIN_ROOT}/hooks/guard_sensitive_paths.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_tmp.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_report_path.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_keywords.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_env_files.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
