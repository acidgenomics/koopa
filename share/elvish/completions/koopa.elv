# Koopa elvish completions.
# @note Updated 2026-08-13.
# @note Auto-generated by 'koopa develop generate-completion'.

use str

set edit:completion:arg-completer[koopa] = {|@args|
    var n = (count $args)
    var last = $args[-1]

    # Flag completions.
    if (str:has-prefix $last '-') {
        var path = ''
        if (>= $n 3) {
            set path = $args[1]
        }
        if (>= $n 4) {
            set path = $path'/'$args[2]
        }
        if (>= $n 5) {
            set path = $path'/'$args[3]
        }
        if (eq $path 'admin') {
            put --help
        } elif (eq $path 'app') {
            put --help
        } elif (eq $path 'app/aws/batch/fetch-and-run') {
            put --help --job-definition --job-name --memory --profile --queue --vcpus
        } elif (eq $path 'app/aws/batch/list-jobs') {
            put --help --profile --queue --status
        } elif (eq $path 'app/aws/ec2/list-running-instances') {
            put --help --profile
        } elif (eq $path 'app/aws/ec2/map-instance-ids-to-names') {
            put --help --profile
        } elif (eq $path 'app/aws/ec2/stop') {
            put --help --profile
        } elif (eq $path 'app/aws/ecr/login-private') {
            put --account-id --help --profile --region
        } elif (eq $path 'app/aws/ecr/login-public') {
            put --help --region
        } elif (eq $path 'app/aws/s3/delete-versioned-glacier-objects') {
            put --bucket --help --prefix --profile
        } elif (eq $path 'app/aws/s3/delete-versioned-objects') {
            put --bucket --help --prefix --profile
        } elif (eq $path 'app/aws/s3/dot-clean') {
            put --dryrun --help --profile
        } elif (eq $path 'app/aws/s3/find') {
            put --bucket --help --pattern --prefix --profile
        } elif (eq $path 'app/aws/s3/list-large-files') {
            put --bucket --help --min-size-mb --prefix --profile
        } elif (eq $path 'app/aws/s3/ls') {
            put --help --profile --recursive
        } elif (eq $path 'app/aws/s3/mv-to-parent') {
            put --dryrun --help --profile
        } elif (eq $path 'app/aws/s3/sync') {
            put --delete --dryrun --exclude --help --include --profile
        } elif (eq $path 'app/aws/s3/sync-git-repo') {
            put --delete --dryrun --help --profile
        } elif (eq $path 'app/bowtie2/align/paired-end') {
            put --fastq-dir --help --index-dir --output-dir --output-format --reference-fasta
        } elif (eq $path 'app/bowtie2/index') {
            put --genome-fasta-file --help --output-dir
        } elif (eq $path 'app/claude/archive-plans') {
            put --days --dry-run --help
        } elif (eq $path 'app/claude/audit-tokens') {
            put --help --max-tokens --project-dir --scope
        } elif (eq $path 'app/conda/create-env') {
            put --file --force --help --latest --prefix
        } elif (eq $path 'app/docker/build') {
            put --help --local --memory --no-push --remote
        } elif (eq $path 'app/docker/build-all-tags') {
            put --help --local --remote
        } elif (eq $path 'app/docker/run') {
            put --arm --bash --bind --help --x86
        } elif (eq $path 'app/file/compress') {
            put --help --output
        } elif (eq $path 'app/ftp/mirror') {
            put --dir --help --host --user
        } elif (eq $path 'app/hisat2/align/paired-end') {
            put --fastq-dir --gtf-file --help --index-dir --output-dir
        } elif (eq $path 'app/hisat2/align/single-end') {
            put --fastq-dir --gtf-file --help --index-dir --output-dir
        } elif (eq $path 'app/hisat2/index') {
            put --genome-fasta-file --gtf-file --help --output-dir
        } elif (eq $path 'app/jekyll/deploy-to-aws') {
            put --bucket --distribution-id --help --local-prefix --profile
        } elif (eq $path 'app/kallisto/index') {
            put --help --output-dir --transcriptome-fasta-file
        } elif (eq $path 'app/kallisto/quant/paired-end') {
            put --fastq-dir --help --index-dir --output-dir
        } elif (eq $path 'app/kallisto/quant/single-end') {
            put --fastq-dir --help --index-dir --output-dir
        } elif (eq $path 'app/koopa/prune-stale-docs') {
            put --help --no-dryrun
        } elif (eq $path 'app/koopa/publish-docs') {
            put --dryrun --help --no-invalidate
        } elif (eq $path 'app/miso/index') {
            put --gff-file --help --output-dir
        } elif (eq $path 'app/python/sync-docs-theme') {
            put --check --help
        } elif (eq $path 'app/r/archive') {
            put --help --no-invalidate
        } elif (eq $path 'app/r/clean-orphan-binaries') {
            put --help --no-invalidate
        } elif (eq $path 'app/r/deploy') {
            put --help --no-invalidate
        } elif (eq $path 'app/r/publish') {
            put --help --no-check --no-deploy --no-invalidate --no-tag
        } elif (eq $path 'app/r/publish-docs') {
            put --help --no-invalidate
        } elif (eq $path 'app/r/publish-from-github') {
            put --check --help --no-invalidate --org
        } elif (eq $path 'app/r/reindex') {
            put --help --no-invalidate
        } elif (eq $path 'app/r/shiny-run-app') {
            put --help --port
        } elif (eq $path 'app/rnaeditingindexer') {
            put --bam-dir --example --genome --help --output-dir
        } elif (eq $path 'app/rsem/index') {
            put --genome-fasta-file --gtf-file --help --num-threads --output-dir
        } elif (eq $path 'app/rsem/quant/bam') {
            put --bam-file --help --index-dir --output-dir
        } elif (eq $path 'app/salmon/detect-fastq-library-type') {
            put --help --index-dir --r1 --r2 --threads
        } elif (eq $path 'app/salmon/index') {
            put --help --output-dir --transcriptome-fasta-file
        } elif (eq $path 'app/salmon/quant/bam') {
            put --fastq-dir --help --index-dir --output-dir
        } elif (eq $path 'app/salmon/quant/paired-end') {
            put --fastq-dir --help --index-dir --output-dir
        } elif (eq $path 'app/salmon/quant/single-end') {
            put --fastq-dir --help --index-dir --output-dir
        } elif (eq $path 'app/sra/download-accession-list') {
            put --file --help --srp-id
        } elif (eq $path 'app/sra/download-run-info-table') {
            put --file --help --srp-id
        } elif (eq $path 'app/sra/fastq-dump') {
            put --fastq-directory --help --no-compress --prefetch-directory
        } elif (eq $path 'app/sra/prefetch') {
            put --accession-file --help --output-dir
        } elif (eq $path 'app/ssh/generate-key') {
            put --help --prefix
        } elif (eq $path 'app/star/align/paired-end') {
            put --fastq-dir --gtf-file --help --index-dir --output-dir
        } elif (eq $path 'app/star/align/single-end') {
            put --fastq-dir --gtf-file --help --index-dir --output-dir
        } elif (eq $path 'app/star/index') {
            put --genome-fasta-file --gtf-file --help --output-dir
        } elif (eq $path 'app/wget/recursive') {
            put --help --password --url --user
        } elif (eq $path 'configure') {
            put --help --verbose
        } elif (eq $path 'develop') {
            put --help
        } elif (eq $path 'develop/activation-fork-audit') {
            put --help --threshold-bash --threshold-zsh --verbose
        } elif (eq $path 'develop/activation-speed-test') {
            put --help --runs --shells --threshold-bash --threshold-fish --threshold-zsh --verbose
        } elif (eq $path 'develop/app-revdeps') {
            put --all --help
        } elif (eq $path 'develop/check-app-versions') {
            put --help --json --no-update --reset-cache --s3-upload --source
        } elif (eq $path 'develop/color-mode-audit') {
            put --help --log --threshold --verbose
        } elif (eq $path 'develop/conda-candidates') {
            put --help --verify
        } elif (eq $path 'develop/mirror-src') {
            put --help --help --prune
        } elif (eq $path 'develop/orphan-apps') {
            put --all --help
        } elif (eq $path 'develop/push-installer') {
            put --force --help --version
        } elif (eq $path 'develop/remove-app') {
            put --help --revdeps
        } elif (eq $path 'develop/scrub-install-info') {
            put --dry-run --help
        } elif (eq $path 'install') {
            put --all --help --no-dependencies --reinstall --verbose
        } elif (eq $path 'list') {
            put --all --help
        } elif (eq $path 'reinstall') {
            put --all --all-revdeps --help --no-revdeps --only-revdeps --verbose
        } elif (eq $path 'run') {
            put --help
        } elif (eq $path 'system') {
            put --help
        } elif (eq $path 'uninstall') {
            put --help --no-revdeps --non-default --verbose --yes
        } elif (eq $path 'update') {
            put --help --verbose
        }
    } elif (== $n 2) {
        # Top-level subcommands.
        put --help --version admin app configure develop install list reinstall run system uninstall update
    } elif (== $n 3) {
        # Depth 1: subcommands of top-level.
        if (eq $args[1] 'app') {
            put aws bioconda bowtie2 brew claude conda current docker file ftp git gpg hisat2 jekyll kallisto koopa md5sum miso photos python r rnaeditingindexer rsem salmon sra ssh star sys wget
        } elif (eq $args[1] 'develop') {
            put activation-fork-audit activation-speed-test app-deps app-revdeps audit-src-mirror bump-bootstrap bump-revision bump-venv-version cache-functions check-app-versions check-skills circular-dependencies color-mode-audit conda-candidates edit-app-json find-ignored-bin-files format-app-json generate-completion generate-docs generate-man log mirror-src orphan-apps prune-app-binaries push-all-app-builds push-app-build push-app-builds push-installer pyright pytest remove-app reset-revisions scrub-install-info shellcheck update-docs
        } elif (eq $args[1] 'run') {
            put autopad-zeros clone convert-svg-to-png convert-utf8-nfd-to-nfc create-dmg delete-broken-symlinks delete-empty-dirs delete-named-subdirs detab df2 dns dot-clean download download-cran-latest download-github-latest entab eol-lf extract extract-all file-count find-and-move-in-sequence find-and-replace find-broken-symlinks find-empty-dirs find-files-without-line-ending find-large-dirs find-large-files ifactive ip-address ip-info line-count merge-pdf move-files-in-batch move-files-up-1-level move-into-dated-dirs-by-filename move-into-dated-dirs-by-timestamp nfiletypes rename-camel-case rename-from-csv rename-kebab-case rename-lowercase rename-snake-case reset-terminal rg-sort rg-unique sort-lines spotlight tar-multiple-dirs update-today-bucket
        } elif (eq $args[1] 'system') {
            put check hostname info list os-slug prefix prune-apps switch-to-develop version which
        } elif (eq $args[1] 'admin') {
            put add-group add-user apk-install apk-remove apk-update apt-install apt-list-installed apt-remove apt-update apt-upgrade clean-launch-services configure-lmod configure-sshd delete-cache delete-user disable-passwordless-sudo disable-touch-id-sudo dnf-install dnf-remove dnf-update enable-passwordless-sudo enable-touch-id-sudo fix-sudo-setrlimit-error flush-dns force-eject install-app os-version pacman-install pacman-remove pacman-update proc-cmdline reload-autofs systemctl-disable systemctl-restart systemctl-status systemctl-stop uninstall-app zsh-compaudit-set-permissions zypper-install zypper-remove zypper-update
        } elif (eq $args[1] 'install') {
            put 1password-cli ack actionlint agat age air anaconda ansible-core antigravity-cli apache-airflow apache-arrow apache-spark apptainer apr apr-util aria2 armadillo asdf aspell aspera-connect ast-grep attr atuin autoconf autodock autodock-adfr autodock-vina autoflake automake aws-azure-login aws-cli aws-mountpoint-s3 axel azure-cli bamtools bandit bandwhich bash bash-completion bash-language-server bash-preexec bashcov bat bc bcbio-nextgen bcl-convert bcl2fastq bedtk bedtools bfg binutils bioawk bioconda-utils bison black blast boost bottom bowtie2 bpytop broot brotli btop bumpver bustools byobu bzip2 c-ares ca-certificates cairo cellranger cereal cheat chemacs chezmoi choose claude-code cli11 clickhouse cloud-sql-proxy cloudbiolinux cmake codex colorls commitizen conda conda-build convmv copilot-cli coreutils cpufetch csvkit csvtk curl dash dask databricks-cli datafusion dbt dbt-bigquery dbt-databricks dbt-postgres dbt-redshift dbt-snowflake deeptools delta diff-so-fancy difftastic direnv docker-credential-helpers doom-emacs dotfiles du-dust duckdb ed editorconfig elfutils elvish emacs emacs-prelude ensembl-perl-api entrez-direct exa exiftool expat eza fastfetch fastqc fd-find ffmpeg ffq fgbio findutils fish flac flake8 flex fltk fmt fontconfig fq fqtk freetype fribidi fzf gatk gawk gcc gdal gdbm gdc-client gemini-cli genomepy gentropy geos gettext gffutils gget gh ghostscript git git-filter-repo git-lfs gitui glances glib gmp gnupg gnutls go google-cloud-sdk googletest gperf gping graphviz grep grex groff gseapy gsl gtop gum gzip hadolint harfbuzz haskell-cabal haskell-ghcup haskell-stack hdf5 helix hexyl hisat2 htop htseq htslib httpie httpx huggingface-hub hugo hurl hyperfine icu4c illumina-ica-cli imagemagick ipython isl isort jemalloc jfrog-cli jj jless jnv jpeg jq julia jupyterlab just k9s kallisto krb5 ksh93 lame lapack latch lazygit ldc ldns less lesspipe libaec libarchive libassuan libcbor libconfig libde265 libdeflate libedit libev libevent lib